# -----------------------------------------------------------------
# Example Environment Variables for BYOD Synthetic Data Service
#
# INSTRUCTIONS:
# 1. Copy this file to a new file named '.env' in the root directory.
# 2. The .env file is listed in .gitignore and will NOT be committed.
# 3. Fill in the values for your own environment.
# Every value in this file is a placeholder. Never put a real key,
# hostname or password in this file: it is committed to a public repository.
# -----------------------------------------------------------------

# -- Environment Configuration --
# CRITICAL: Set this correctly for each environment
# Options: local, development, production
ENVIRONMENT="local"

# -- CORS Security Settings --
# CRITICAL: Configure allowed origins to prevent security vulnerabilities
# Format: comma-separated list of allowed origins (no spaces after commas)
#
# Local development examples:
# Basic local:
ALLOWED_ORIGINS="http://localhost:8201,http://localhost:3000,http://127.0.0.1:8201"
#
# WSL + Windows VS Code + SSH scenarios (uncomment and modify as needed):
# ALLOWED_ORIGINS="http://localhost:8201,http://localhost:3000,http://127.0.0.1:8201,http://0.0.0.0:8201,http://localhost:8080"
#
# With specific VM IP for SSH port forwarding:
# ALLOWED_ORIGINS="http://localhost:8201,http://localhost:3000,http://192.168.1.100:8201,http://your-vm-hostname:8201"
#
# Deployed site example (only the site's own address):
# ALLOWED_ORIGINS="https://<your-site-address>"

# -- Azure OpenAI Service (auth + telemetry via src/dcri_llm.py) --
# REQUIRED. Without AZURE_OPENAI_ENDPOINT, /ready answers 503 and every generation
# request fails with a clear error. There is no generator without the AI model.
AZURE_OPENAI_ENDPOINT="https://<your-foundry>.openai.azure.com/"
# How the app signs in to Azure OpenAI.
# identity (default): `az login` locally, managed identity when deployed. No key needed.
LLM_AUTH="identity"
# Only with LLM_AUTH=key, for people without an Azure identity:
# AZURE_OPENAI_API_KEY="<your-aoai-api-key>"
SOLUTION_NAME="mock-data-generator"
# The server default model (an Azure OpenAI deployment name).
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME="gpt-5-nano"
AZURE_OPENAI_API_VERSION="2025-04-01-preview"
# Models a request may choose with `model`: comma-separated deployment names.
# Unset = the built-in list in src/core/models.py. The default above is always allowed.
# LLM_ALLOWED_MODELS="<deployment-name-1>,<deployment-name-2>"
# Reasoning effort sent to reasoning models. Default low. off = do not send the setting.
# LLM_REASONING_EFFORT="low"

# -- Request limits and the /api/v1 key --
# Largest request body on the upload routes, in bytes. Default 52428800 (50 MB).
# MOCKDATA_MAX_UPLOAD_BYTES="52428800"
# If set, every /api/v1 request must send this value in the X-API-Key header.
# Unset = no key check. Other routes never check a key.
# MOCKDATA_API_KEY="<choose-a-long-random-value>"
# Largest request body on /api/v1, in bytes. Default 10485760 (10 MB).
# MOCKDATA_API_MAX_BYTES="10485760"
# Largest data dictionary file, in bytes. Default 67108864 (64 MB).
# MOCKDATA_DICTIONARY_MAX_BYTES="67108864"
# Most characters of a data dictionary sent to the AI model. Default 60000.
# MOCKDATA_DICTIONARY_PROMPT_MAX_CHARS="60000"

# -- Application Settings --
# Part of every cache key. Raising it retires every cached script.
GENERATOR_VERSION="1.1"
LOG_LEVEL="INFO" # e.g., DEBUG, INFO, WARNING, ERROR
APP_PORT="8201" # Default port for the application
# Folder for cached descriptions and generated scripts. Default ./data/cache
# LOCAL_CACHE_PATH="./data/cache"

# -- Managed identity (deployed container only) --
# With LLM_AUTH=identity on Azure Container Apps, src/dcri_llm.py signs in with the
# user-assigned managed identity whose client id is given here. Not needed locally.
# AZURE_CLIENT_ID="<user-assigned-identity-client-id>"

# -- Settings the application code does not use --
# src/utils/config.py still accepts these from an earlier plan (Blob Storage for
# uploads, Cosmos DB, AI Search, a service principal). The application code does
# not use their values. Leave them unset.
# AZURE_TENANT_ID=""
# AZURE_CLIENT_SECRET=""
# AZURE_STORAGE_CONNECTION_STRING=""
# BLOB_STORAGE_CONTAINER_NAME=""
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=""
# COSMOS_DB_ENDPOINT=""
# COSMOS_DB_KEY=""
# COSMOS_DB_DATABASE_NAME=""
# COSMOS_DB_CONTAINER_NAME=""
# AZURE_SEARCH_ENDPOINT=""
# AZURE_SEARCH_API_KEY=""
# AZURE_SEARCH_INDEX_NAME=""
